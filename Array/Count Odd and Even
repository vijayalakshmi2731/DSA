// https://www.geeksforgeeks.org/problems/count-odd-even/1
// Count Odd and Even

class Solution {
    public int[] countOddEven(int[] arr) {
        int even=0, odd=0;
        int n=arr.length; 
        
        for(int i=0;i<n;i++){
            if(arr[i]%2==0){
                even++;
            }else{
                odd++;
            }
           
        }
        return new int[]{odd,even};
    }
}
