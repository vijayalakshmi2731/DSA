// Given an integer array arr[], return the sum of all elements of arr.
// https://www.geeksforgeeks.org/problems/sum-all-array-elements/1

class Solution {
    public int arraySum(int arr[]) {
        int sum=0;
        int n = arr.length;
        for(int i=0;i<n;i++){
            sum=sum+arr[i];
        }
        return sum;
    }
}
