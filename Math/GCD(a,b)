class Solution {
    public static int gcd(int a, int b) {
        int n=0;
        if (a<b){
            n=a;
        }
        else{
            n=b;
        }
        
        int gcdVal=1;
        
        for(int i=2; i<=n; i++){
            if(a%i==0 && b%i==0){
                gcdVal=i;
            }
        }
        return gcdVal;
    }
}
