// https://www.geeksforgeeks.org/problems/special-odd-series-sum1235/1
//  1 + (1+3) + (1+3+5) + (1+3+5+7) + …… + (1+3+5+7+…+(2n-1))

class Solution {
    static long sumOfTheSeries(long n) {
        int sum=0, seriesSum=0;
        
        for(int i=1;i<=2*n-1;i=i+2){
            sum=sum+i;
            seriesSum=seriesSum+sum;
        }
        return seriesSum;
    }
}
