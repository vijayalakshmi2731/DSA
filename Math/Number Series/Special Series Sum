// 1 + (1+2) + (1+2+3+4) ......(1+2+3+4......+n)

class Solution {
    static long sumOfTheSeries(long n){
        // code here
        long termSum=0, totalSum=0;
        for(int i=1; i<=n; i++){
            termSum=termSum+i;
            totalSum=totalSum+termSum;
        }
        return totalSum;
    }
}
