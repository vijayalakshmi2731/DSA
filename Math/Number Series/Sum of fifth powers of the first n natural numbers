// https://www.geeksforgeeks.org/problems/sum-of-fifth-powers-of-the-first-n-natural-numbers3415/1

class Solution {
    long sumOfFifthPowers(long N) {
        long sum=0;
        for(long i=1;i<=N;i++){
            long power= (long)Math.pow(i,5);
            sum= sum + power;
        }
        return sum;
    }
}
