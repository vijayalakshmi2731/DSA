// https://www.geeksforgeeks.org/problems/count-squares3649/1
// i.e., 1, 4, 9, 16, 25, …

class Solution {
    static int countSquares(int n) {
        int perfectSq=0;
        int count=0;
        
        for (int i=1; i<Math.sqrt(n);i++){
            perfectSq= i*i;
            if(perfectSq<n){
                count++;
            }
        }
        return count;
        
    }
}
