/*---------------------------------------------------------------------------------------------
https://www.geeksforgeeks.org/problems/corner-digits1317/1
Example 1:

Input: N = 12345
Output: 6
Explanation: 1st and last digits are 1 and 5.
Example 2:

Input: 98562
Output: 11
Explanation: 1st and last digits are 9 and 2. 
---------------------------------------------------------------------------------------------*/


class Solution {
    public int corner_digitSum(int n) {

        if (n < 10) {
            return n;
        }

        int ld = n % 10;

        while (n >= 10) {
            n = n / 10;
        }

        int fd = n;

        return fd + ld;
  
    }
}
