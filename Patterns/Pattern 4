/* ----------------------------------
Input:
N = 3
Output:
* ** *** 
https://www.geeksforgeeks.org/problems/pattern-printing1347/1?page=1&category=pattern-printing&sortBy=submissions
------------------------------------*/

class Solution {
    static void printPattern(int N) {
        for (int i=1; i<=N; i++){
            for (int j=1;j<=i;j++){
                System.out.print("*");
            }
            System.out.print(" ");
        }
    }
}
